@model IEnumerable<Shyrian_project.Models.BloodRequest>
@{
    ViewData["Title"] = "Manage Blood Requests";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-secondary">All Blood Requests</h2>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Requester Email</th>
                        <th>Required Blood Type</th>
                        <th>Request Date</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No blood requests available.</td>
                        </tr>
                    }
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td class="align-middle">@request.Requester?.Email</td>
                            <td class="align-middle fw-bold text-danger">@request.BloodType?.Name</td>
                            <td class="align-middle">@request.RequestDate.ToString("MMM dd, yyyy")</td>
                            <td class="align-middle">
                                @if (request.Status == RequestStatus.Open)
                                {
                                    <span class="badge bg-success">Open</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Fulfilled</span>
                                }
                            </td>
                            <td class="align-middle text-center">
                                <form asp-action="DeleteRequest" method="post" onsubmit="return confirm('Are you sure you want to delete this request?');">
                                    <input type="hidden" name="requestId" value="@request.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>