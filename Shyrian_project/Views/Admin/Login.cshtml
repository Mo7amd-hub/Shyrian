@{
    ViewData["Title"] = "Login for Admins";
    Layout = "_Layout";
}

<div class="container mt-5" dir="rtl" style="text-align: right;">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-lg mt-5">
                <div class="card-header bg-danger text-white text-center">
                    <h3 class="font-weight-light my-2">Admin Entry - Shyrian</h3>
                </div>
                <div class="card-body">
                    
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger text-center">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-controller="Admin" asp-action="Login" method="post">
                        <div class="form-group mb-3">
                            <label class="mb-1">Email</label>
                            <input class="form-control py-3" name="email" type="email" placeholder="Enter the Email Address" required />
                        </div>
                        <div class="form-group mb-4">
                            <label class="mb-1">Password</label>
                            <input class="form-control py-3" name="password" type="password" placeholder="Enter the Password" required />
                        </div>
                        <div class="form-group mt-4 mb-0">
                            <button type="submit" class="btn btn-danger btn-block w-100 py-2">Login</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>