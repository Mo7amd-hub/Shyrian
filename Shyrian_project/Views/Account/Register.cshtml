@model Shyrian_project.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create an Account";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white text-center py-3">
                    <h4 class="mb-0">Join Shyrian Donors</h4>
                </div>
                <div class="card-body p-4">
                    
                    <form asp-controller="Account" asp-action="Register" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="FirstName" class="fw-bold mb-1">First Name</label>
                                <input asp-for="FirstName" class="form-control" required />
                            </div>
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="LastName" class="fw-bold mb-1">Last Name</label>
                                <input asp-for="LastName" class="form-control" required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Email" class="fw-bold mb-1">Email</label>
                                <input asp-for="Email" type="email" class="form-control" required />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="PhoneNumber" class="fw-bold mb-1">Phone Number</label>
                                <input asp-for="PhoneNumber" class="form-control" required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group mb-3">
                                <label asp-for="BloodTypeId" class="control-label fw-bold"></label>
                                <select asp-for="BloodTypeId" class="form-select border-danger" asp-items="@(new SelectList(ViewBag.BloodTypes, "Id", "Name"))">
                                    <option value="">-- Optional: Choose Later --</option>
                                </select>
                                <!-- التحذير الأحمر -->
                                <p class="text-danger small fw-bold mt-1">
                                    <i class="bi bi-exclamation-triangle"></i> Attention: Your blood type cannot be changed after registration.
                                </p>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Password" class="fw-bold mb-1">Password</label>
                                <input asp-for="Password" type="password" class="form-control" required placeholder="Enter your password" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="ConfirmPassword" class="fw-bold mb-1">Confirm Password</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" required placeholder="Confirm your password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label class="fw-bold mb-1">Governorate</label>
                                <select asp-for="GovernorateId" class="form-select" id="governorateDropdown" required>
                                    <option value="">-- Select Governorate --</option>
                                    @foreach (var gov in ViewBag.Governorates)
                                    {
                                        <option value="@gov.Id">@gov.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 form-group mb-3">
                                <label class="fw-bold mb-1">City</label>
                                <select asp-for="CityId" class="form-select" id="cityDropdown" required>
                                    <option value="">-- Select City First --</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label class="fw-bold mb-1">Proof Document (Optional)</label>
                            <input asp-for="DocumentFile" type="file" class="form-control" accept="image/*,.pdf" />
                            <small class="text-muted">Upload medical proof of your blood type to get verified.</small>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 py-2">Register</button>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- This script handles the cascading dropdown (Governorates -> Cities) -->
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
        $("#governorateDropdown").change(function () {
        var govId = $(this).val();
        var cityDropdown = $("#cityDropdown");
                
        cityDropdown.empty();
        cityDropdown.append('<option value="">-- Select City --</option>');

        if (govId) {
        $.ajax({
        url: '/Account/GetCities',
        type: 'GET',
        data: { governorateId: govId },
        success: function (data) {
        $.each(data, function (index, item) {
        cityDropdown.append($('<option></option>').val(item.id).text(item.name));
        });
        }
        });
        }
        });
        });
    </script>
}